{
  "name": "paladinscat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pinned-locales.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pinned-locales.mjs && node scripts/audit-text-size.mjs && node scripts/audit-localization.mjs --strict",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate-types": "npx openapi-typescript http://localhost:3005/openapi.json -o lib/types.gen.ts",
    "sync-community-locales": "node scripts/sync-community-locales.mjs",
    "sync-pinned-locales": "node scripts/copy-pinned-locales.mjs",
    "audit-localization": "node scripts/audit-localization.mjs",
    "audit-text-size": "node scripts/audit-text-size.mjs",
    "migrate-localization": "node scripts/migrate-hardcoded-localization.mjs",
    "sync-talent-assets": "node scripts/sync-champion-talent-ids.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@next/swc-wasm-nodejs": "^16.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.9.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "openapi-typescript": "^6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6"
  }
}
