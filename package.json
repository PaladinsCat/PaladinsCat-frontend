{
  "name": "paladinscat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-localization-catalog.mjs && node scripts/sync-community-locales.mjs && node scripts/copy-pinned-locales.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pinned-locales.mjs && node scripts/audit-champion-data.mjs && node scripts/check-localization-catalog.mjs && node scripts/check-localization-keys.mjs && node scripts/audit-text-size.mjs && node scripts/audit-localization.mjs --strict",
    "build": "node scripts/audit-image-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:diminishing-returns": "node --experimental-strip-types --test lib/diminishing-returns.test.ts",
    "test:items": "node --experimental-strip-types --test lib/active-items.test.ts",
    "generate-types": "npx openapi-typescript http://localhost:3005/openapi.json -o lib/types.gen.ts",
    "sync-community-locales": "node scripts/sync-community-locales.mjs",
    "sync-pinned-locales": "node scripts/copy-pinned-locales.mjs",
    "sync-loading-frames": "node scripts/sync-loading-frames.mjs",
    "audit-localization": "node scripts/audit-localization.mjs",
    "audit-text-size": "node scripts/audit-text-size.mjs",
    "audit-image-assets": "node scripts/audit-image-assets.mjs",
    "audit-champion-data": "node scripts/audit-champion-data.mjs",
    "audit:champion-wiki": "node scripts/audit-champion-wiki.mjs",
    "check-localization-catalog": "node scripts/check-localization-catalog.mjs",
    "check-localization-keys": "node scripts/check-localization-keys.mjs",
    "migrate-localization": "node scripts/migrate-hardcoded-localization.mjs",
    "sync-talent-assets": "node scripts/sync-champion-talent-ids.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@heroui/react": "^3.2.3",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@next/swc-wasm-nodejs": "^16.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.15",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.9.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "openapi-typescript": "^6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.20"
    }
  }
}
